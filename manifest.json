{
  "manifest_version": 3,
  "name": "Advanced Privacy Blocker",
  "short_name": "Privacy Blocker",
  "version": "2.1.0",
  "description": "Blocks ads, trackers, consent popups, known malware destinations and distractions with tracker intelligence and privacy controls.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/32.png"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/content-tools.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core_ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "core_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      {
        "id": "core_annoyances",
        "enabled": true,
        "path": "rules/annoyances.json"
      },
      {
        "id": "core_malware",
        "enabled": true,
        "path": "rules/malware.json"
      },
      {
        "id": "backup",
        "enabled": false,
        "path": "rules/backup_ruleset.json"
      },
      {
        "id": "ads_static_0",
        "enabled": false,
        "path": "rules/generated/ads_static_0.json"
